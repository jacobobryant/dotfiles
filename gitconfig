[user]
	email = git@jacobobryant.com
	name = Jacob O'Bryant
[core]
	editor = nvim
	#excludesfile = /home/jacob/.git/gitignore
[push]
	autoSetupRemote = true
[init]
	defaultBranch = master
[credential "https://github.com"]
	helper = 
	helper = "!f() { GH_TOKEN=\"${GITHUB_PAT:-$GH_TOKEN}\" /usr/bin/gh auth git-credential \"$@\"; }; f"
	helper = store
[credential "https://gist.github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
